+static void emit(httpd_ws_frame_t*f){
+ printf("{\"frame\":%.*s,\"fd\":%d,\"bytes\":\"",(int)f->len,f->payload,sent_fd);
+ for(size_t i=0;i<f->len;i++){unsigned char c=f->payload[i];if(c=='"'||c=='\\')putchar('\\');if(c<32)printf("\\u%04x",c);else putchar(c);}puts("\"}");
